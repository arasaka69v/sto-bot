# ============================================================
#  Настройки бота. Скопируйте этот файл в .env и заполните.
#  .env НЕ попадает в git — там хранятся секреты.
# ============================================================

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID через запятую (узнать свой ID: @userinfobot)
# Админы могут оформлять заказы. Админ автоматически считается и мастером.
ADMIN_IDS=
MASTER_IDS=

# --- Поставщик ---
# mock   — тестовые данные (ключи не нужны)
# rossko — реальный API Росско (настраивается через rossko_setup.bat)
SUPPLIER=mock

# true  — заказ НЕ отправляется, бот только показывает, что бы отправил
# false — заказ реально уходит поставщику
TEST_MODE=true

# --- Росско ---
# Проще всего заполнить автоматически: запустите rossko_setup.bat.
# Он спросит ключи, покажет ваши способы доставки/оплаты и всё запишет сам.
ROSSKO_KEY1=
ROSSKO_KEY2=
# Способ доставки (id из GetCheckoutDetails) — нужен и для поиска, и для заказа
ROSSKO_DELIVERY_ID=
# Адрес доставки (необязательно, например при самовывозе)
ROSSKO_ADDRESS_ID=
# Способ оплаты и юрлицо для оплаты
ROSSKO_PAYMENT_ID=
ROSSKO_REQUISITE_ID=
# Контакт для заказов
ROSSKO_CONTACT_NAME=
ROSSKO_CONTACT_PHONE=
# Поле delivery_parts из API Росско (смысл уточните у менеджера)
ROSSKO_DELIVERY_PARTS=false

# --- ИИ для распознавания названий деталей (необязательно) ---
# Без ключа бот понимает названия по встроенному словарю.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Выбор самого выгодного варианта ---
# «Нормальный» срок доставки в днях
NORMAL_DELIVERY_DAYS=3
CURRENCY_SYMBOL=₸

# --- Файлы ---
DB_PATH=data/sto_bot.db
LOG_PATH=data/logs/bot.log
